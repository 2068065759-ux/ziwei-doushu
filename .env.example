# 复制为 .env.local 后按需填写

# ─── 推荐：直接使用你的 ChatGPT Plus / Pro 套餐 ───
# 本地或自托管环境先运行：npm run chatgpt:login
# 授权成功后会生成本地 .chatgpt-plan.json，程序自动读取并刷新。
# 如需把授权文件放到其他安全目录，可指定：
# CHATGPT_PLAN_AUTH_FILE=/absolute/path/to/.chatgpt-plan.json

# ─── 备用：OpenAI API Key ───
# 当没有 ChatGPT 套餐授权文件时，才会使用下面的 API Key。
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-6.1-terra

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
